generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(60)
  rank        Int
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("role")
}

model Permission {
  id        Int              @id @default(autoincrement())
  code      String           @unique @db.VarChar(60)
  label     String           @db.VarChar(120)
  groupName String           @db.VarChar(60)
  roles     RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("rolepermission")
}

model User {
  id                 Int       @id @default(autoincrement())
  formDrafts         FormDraft[]
  email              String    @unique @db.VarChar(160)
  name               String    @db.VarChar(100)
  passwordHash       String    @db.VarChar(255)
  roleId             Int
  role               Role      @relation(fields: [roleId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  phone              String?   @db.VarChar(30)
  branch             String?   @db.VarChar(100)
  photoFile          String?   @db.VarChar(120)
  theme              String    @default("light") @db.VarChar(10)
  dailyDigest        Boolean   @default(true)
  reservationReleased Boolean  @default(false)
  privacyAcceptedVersion Int?
  privacyAcceptedAt  DateTime?
  sessions           Session[]
  auditLogs          AuditLog[]
  receipts           Receipt[]          @relation("Encoder")
  paymentsReceived   Payment[]          @relation("PaymentPayee")
  paymentsRecorded   Payment[]          @relation("PaymentRecorder")
  notifications      Notification[]
  comments           Comment[]          @relation("CommentAuthor")
  passwordTokens     PasswordToken[]    @relation("PasswordTokens")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([roleId])
  @@map("user")
}

model Session {
  id         String    @id @default(uuid()) @db.VarChar(36)
  tokenHash  String    @unique @db.VarChar(64)
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?   @db.VarChar(255)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@map("session")
}

/// Append-only. The application never updates or deletes rows here.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String   @db.VarChar(160)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(60)
  summary    String?  @db.VarChar(255)
  before     String?  @db.LongText
  after      String?  @db.LongText
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("auditlog")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(80)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  receipts  Receipt[]
  createdAt DateTime  @default(now())

  @@map("category")
}

/// A form that was started and not finished. Saved as the person types, so a wrong exit loses nothing. Not a receipt: it is not listed, counted or seen by anyone else.
model FormDraft {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The receipt being edited, or empty for a new one.
  receiptId Int?
  receipt   Receipt? @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  step      Int      @default(0)
  /// The answers as typed (JSON text).
  data      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, receiptId])
  @@index([userId, updatedAt])
  @@map("form_draft")
}

/// Where a receipt is charged ("Choose where to charge"). An administrator edits the list.
model ChargeLocation {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(120)
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  receipts  Receipt[]
  createdAt DateTime  @default(now())

  @@map("charge_location")
}

model Receipt {
  id           Int                      @id @default(autoincrement())
  refNo        String                   @unique @db.VarChar(30)
  encoderId    Int
  encoder      User                     @relation("Encoder", fields: [encoderId], references: [id])
  payee        String                   @db.VarChar(160)
  receiptDate  DateTime                 @db.Date
  amount       Decimal                  @db.Decimal(12, 2)
  categoryId   Int?
  category     Category?                @relation(fields: [categoryId], references: [id])
  description  String?                  @db.VarChar(500)
  // Client form (phase 2). All optional so receipts made before it still load.
  birInvoice      Boolean?
  invoiceUnderCompany Boolean?
  reasonForSpending   String?                  @db.VarChar(300)
  classification      String?                  @db.VarChar(30)
  classificationOther String?                  @db.VarChar(100)
  seenCompany     Boolean?
  seenTin         Boolean?
  seenAddress     Boolean?
  noBirReason     String?                  @db.VarChar(500)
  invoiceNo       String?                  @db.VarChar(60)
  vendorAddress   String?                  @db.VarChar(300)
  vendorTin       String?                  @db.VarChar(30)
  transactionType String?                  @db.VarChar(10)
  vatType         String?                  @db.VarChar(12)
  vatableAmount   Decimal?                 @db.Decimal(12, 2)
  vatAmount       Decimal?                 @db.Decimal(12, 2)
  vatExemptAmount Decimal?                 @db.Decimal(12, 2)
  discountAmount  Decimal?                 @db.Decimal(12, 2)
  withheld        Boolean?
  whtRate         Decimal?                 @db.Decimal(5, 2)
  whtAmount       Decimal?                 @db.Decimal(12, 2)
  // Last page of the form: where to charge.
  chargeLocationId     Int?
  chargeLocation       ChargeLocation?          @relation(fields: [chargeLocationId], references: [id])
  formDrafts           FormDraft[]
  ckCompany       Boolean?
  ckTin           Boolean?
  ckAddress       Boolean?
  status       String                   @default("draft") @db.VarChar(20)
  version      Int                      @default(0)
  submittedAt  DateTime?
  checkedById  Int?
  checkedAt    DateTime?
  checkNote    String?                  @db.VarChar(1000)
  decidedById  Int?
  decidedAt    DateTime?
  decisionNote String?                  @db.VarChar(1000)
  lastNote     String?                  @db.VarChar(1000)
  // The problems ticked when the receipt was sent back (codes joined by commas, see packages/shared/src/returnIssues.ts). Cleared when it leaves "Returned".
  returnIssues String?                  @db.VarChar(300)
  // Payment step. Filled while the receipt is Paid and cleared again when the payment is reversed.
  paymentId       Int?
  payment         Payment?                 @relation(fields: [paymentId], references: [id])
  paidAmount      Decimal?                 @db.Decimal(12, 2)
  paidShortReason String?                  @db.VarChar(300)
  paidAt          DateTime?
  evidence     ReceiptEvidence[]
  document     ReimbursementDocument?
  comments     Comment[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status])
  @@index([encoderId])
  @@index([receiptDate])
  @@index([categoryId])
  @@index([vendorTin, invoiceNo])
  @@index([paymentId])
  @@map("receipt")
}

model ReceiptEvidence {
  id           Int       @id @default(autoincrement())
  receiptId    Int
  receipt      Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  fileName     String    @db.VarChar(200)
  storedName   String    @db.VarChar(80)
  mime         String    @db.VarChar(60)
  size         Int
  sha256       String    @db.VarChar(64)
  uploadedById Int
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([receiptId])
  @@map("receiptevidence")
}

model ReimbursementDocument {
  id          Int       @id @default(autoincrement())
  receiptId   Int       @unique
  receipt     Receipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  docNo       String    @unique @db.VarChar(30)
  status      String    @default("pending") @db.VarChar(10)
  filePath    String?   @db.VarChar(200)
  generatedAt DateTime?
  error       String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())

  @@map("reimbursementdocument")
}

/// One payment made by Accounting to one Med Ref. It can cover several receipts. Rows are never edited or deleted.
model Payment {
  id           Int       @id @default(autoincrement())
  paymentNo    String    @unique @db.VarChar(30)
  payeeId      Int
  payee        User      @relation("PaymentPayee", fields: [payeeId], references: [id])
  method       String    @db.VarChar(40)
  paidOn       DateTime  @db.Date
  proofFile    String    @db.VarChar(200)
  proofMime    String    @db.VarChar(60)
  proofSize    Int
  proofSha256  String    @db.VarChar(64)
  recordedById Int
  recordedBy   User      @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  receipts     Receipt[]

  @@index([payeeId])
  @@index([recordedById])
  @@map("payment")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(40)
  text      String    @db.VarChar(300)
  receiptId Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notification")
}

model EmailLog {
  id        Int       @id @default(autoincrement())
  userId    Int?
  toEmail   String    @db.VarChar(160)
  template  String    @db.VarChar(40)
  subject   String    @db.VarChar(200)
  body      String    @db.Text
  status    String    @default("queued") @db.VarChar(10)
  attempts  Int       @default(0)
  error     String?   @db.VarChar(300)
  /// What the mail server said when it took the message, for example "250 2.0.0 OK". Proof it was handed over.
  response  String?   @db.VarChar(300)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status])
  @@map("emaillog")
}

model Job {
  id         Int       @id @default(autoincrement())
  type       String    @db.VarChar(30)
  payload    String    @db.Text
  status     String    @default("pending") @db.VarChar(10)
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  lastError  String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
  @@map("job")
}

model LiquidationReport {
  id            Int       @id @default(autoincrement())
  requestedById Int
  format        String    @db.VarChar(5)
  filters       String    @db.Text
  status        String    @default("pending") @db.VarChar(10)
  filePath      String?   @db.VarChar(200)
  rowCount      Int?
  total         Decimal?  @db.Decimal(14, 2)
  error         String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([requestedById])
  @@map("liquidationreport")
}

model ImportJob {
  id          Int       @id @default(autoincrement())
  userId      Int
  fileName    String    @db.VarChar(200)
  status      String    @default("previewed") @db.VarChar(12)
  rows        String    @db.LongText
  errors      String    @db.LongText
  totalRows   Int
  validRows   Int
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@map("importjob")
}

model Sequence {
  key   String @id @db.VarChar(40)
  value Int

  @@map("sequence")
}

/// Settings an administrator edits in the app (for example the mail account). Secrets inside are encrypted.
model Setting {
  key         String   @id @db.VarChar(60)
  value       String   @db.Text
  updatedAt   DateTime @updatedAt
  updatedById Int?

  @@map("setting")
}

model Comment {
  id        Int      @id @default(autoincrement())
  receiptId Int
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id])
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([receiptId, id])
  @@map("comment")
}

/// One-time links for choosing a password: "forgot password" (short life) and the invitation for a new user (longer).
model PasswordToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation("PasswordTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  purpose   String    @db.VarChar(10)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("passwordtoken")
}
