NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:@localhost:3306/reimsys"
WEB_ORIGIN=http://localhost:5173
SESSION_DAYS=7
STORAGE_DIR=./storage
# Email. Leave SMTP_HOST empty in development: messages are written to the email log and the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="REIMSYS <no-reply@example.com>"
ORG_NAME="REIMSYS"
# Production: a long random text that locks the mail password saved in the app. Keep it with your other secrets. If it is not set, a key file is made in the
# storage folder (storage/.settings-key) and must travel with the database whenever you move to another server.
SETTINGS_KEY=
