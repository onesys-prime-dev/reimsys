NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:@localhost:3306/reimsis"
WEB_ORIGIN=http://localhost:5173
SESSION_DAYS=7
STORAGE_DIR=./storage
# Email. Leave SMTP_HOST empty in development: messages are written to the email log and the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="REIMSYS <no-reply@example.com>"
ORG_NAME="REIMSYS"
