{
  "name": "reimsys",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @reimsys/api --filter @reimsys/web dev",
    "dev:api": "pnpm --filter @reimsys/api dev",
    "dev:web": "pnpm --filter @reimsys/web dev",
    "db:migrate": "pnpm --filter @reimsys/api db:migrate",
    "db:seed": "pnpm --filter @reimsys/api db:seed",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:api": "node e2e/api-flow.mjs",
    "test:ui": "node e2e/ui-flow.mjs",
    "test:all": "node e2e/run-all.mjs",
    "build": "pnpm --filter @reimsys/web build && pnpm --filter @reimsys/api build"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.9.38",
    "playwright": "^1.64.0",
    "smtp-server": "^3.19.21",
    "vitest": "^5.0.3"
  }
}
